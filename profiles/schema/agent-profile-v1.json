{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skillhub:agent-profile:v1",
  "title": "Skill Hub Agent profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "packageFormat",
    "variants",
    "defaultVariant",
    "roots"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "packageFormat": {
      "const": "skill-md-v1"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "defaultVariant": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/root"
      }
    },
    "probes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/probe"
      }
    },
    "binaryNames": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "iconKey": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "monogram": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4096
    }
  },
  "$defs": {
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootId",
        "platforms",
        "scope",
        "base",
        "relative",
        "discovery",
        "role",
        "read",
        "write",
        "priority"
      ],
      "properties": {
        "rootId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "windows",
              "macos",
              "linux"
            ]
          }
        },
        "scope": {
          "enum": [
            "user",
            "project"
          ]
        },
        "base": {
          "enum": [
            "home",
            "project",
            "appdata",
            "xdg-config"
          ]
        },
        "relative": {
          "type": "string",
          "minLength": 1
        },
        "discovery": {
          "enum": [
            "children",
            "ancestors-to-repo"
          ]
        },
        "role": {
          "enum": [
            "native",
            "compatibility"
          ]
        },
        "read": {
          "type": "boolean"
        },
        "write": {
          "type": "boolean"
        },
        "priority": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "appliesToVariants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "readEvidence": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "always"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "probeId"
              ],
              "properties": {
                "kind": {
                  "const": "bool-config-v1"
                },
                "probeId": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probeId",
        "base",
        "relative",
        "format",
        "keyPath",
        "expected",
        "onMissing"
      ],
      "properties": {
        "probeId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64
        },
        "base": {
          "enum": [
            "home",
            "project",
            "appdata",
            "xdg-config"
          ]
        },
        "relative": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "json",
            "toml"
          ]
        },
        "keyPath": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "expected": {
          "type": "boolean"
        },
        "onMissing": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "const": "unknown"
            }
          ]
        }
      }
    }
  }
}
